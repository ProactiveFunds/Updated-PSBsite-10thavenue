---
import '../styles/global.css';
import '../styles/responsive.css';
import '../styles/motion.css';
import AssetsPage from '../components/AssetsPage.jsx';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <script is:inline>try{var t=localStorage.getItem('psb-theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Explore the Proactive Sustainable Bonds portfolio. Filter by fund, status, and state, and open any asset to see its fund, acquisition date, and impact." />
    <title>Assets — Proactive Sustainable Bonds</title>
  </head>
  <body>
    <AssetsPage client:load />
  </body>
</html>
